# --- Server ---
NODE_ENV=development
PORT=3000
# Base URL used to build the full short link returned to clients
BASE_URL=http://localhost:3000
# Comma-separated CORS allowlist, or "*" to allow all origins
CORS_ORIGINS=*
LOG_LEVEL=info
# Proxy hops in front of the app (or "true"/"false"/subnet list). Must match
# your deployment or client IPs (rate limits, geo) will be wrong.
TRUST_PROXY=1

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener

# --- Auth (Better Auth) ---
# Signing/encryption secret, 32+ chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-char-min-random-secret
# Public base URL Better Auth issues links/cookies for.
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend — required in production) ---
# Dev/test: emails are logged, not sent. Production requires both vars below.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=URL Shortener <onboarding@yourdomain.com>

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
# Public redirects, per IP per minute
REDIRECT_RATE_LIMIT_MAX=600
# Shared rate-limit counters across instances (docker-compose maps 6380).
# Unset = per-process limits (fine for a single instance).
# REDIS_URL=redis://localhost:6380

# --- Abuse / privacy ---
# Google Safe Browsing v4 key: blocks shortening of flagged URLs when set.
# SAFE_BROWSING_API_KEY=
# Delete click analytics older than N days. Unset = keep forever.
# CLICK_RETENTION_DAYS=395

# --- Sqids (legacy) ---
# New links get random codes. These only matter when migrating a database
# created before that: keep them equal to what that deployment used so
# existing short links keep resolving.
SQIDS_MIN_LENGTH=6
SQIDS_ALPHABET=
# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=