meta {
  name: Get JWT Token
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/auth/token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

tests {
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  try {
    const data = res.getBody();
    if (data.token) bru.setVar('jwtToken', data.token);
  } catch (e) {}
}

docs {
  Returns a verifiable EdDSA JWT (jwt plugin). Validate statelessly via JWKS.
}
