meta {
  name: Request Password Reset
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/request-password-reset
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "redirectTo": "{{baseUrl}}/reset-password"
  }
}

vars:pre-request {
  email: devanshverma1609@gmail.com
}

tests {
  test('2xx success', () => expect(res.getStatus()).to.be.oneOf([200, 201]));
}

docs {
  Sends a password reset email (logged in dev, sent via Resend in production).
}
