meta {
  name: Delete Link
  type: http
  seq: 99
}

delete {
  url: {{baseUrl}}/api/v1/links/{{linkId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

tests {
  test('204 No Content', () => expect(res.getStatus()).to.equal(204));
}

docs {
  Soft-deletes a link owned by the active organization.
}
