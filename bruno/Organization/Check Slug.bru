meta {
  name: Check Slug
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/organization/check-slug
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "slug": "{{orgSlug}}"
  }
}

tests {
  test('2xx or slug taken', () => expect(res.getStatus()).to.be.oneOf([200, 201, 400]));
  try {
    if (res.getStatus() === 200 || res.getStatus() === 201) {
      test('slug available', () => expect(res.getBody().status).to.eql(true));
    }
  } catch (e) {}
}

docs {
  Checks whether an organization slug is available.
}
