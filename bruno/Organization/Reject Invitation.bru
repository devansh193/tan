meta {
  name: Reject Invitation
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/organization/reject-invitation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "invitationId": "{{invitationId}}"
  }
}

tests {
  test('2xx or expected error', () => expect(res.getStatus()).to.be.oneOf([200, 201, 400, 403, 404]));
}

docs {
  Rejects a pending invitation (called by the invited user).
}
