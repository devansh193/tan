meta {
  name: Leave Organization
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/organization/leave
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "organizationId": "{{organizationId}}"
  }
}

tests {
  test('2xx or expected error', () => expect(res.getStatus()).to.be.oneOf([200, 201, 400, 403, 404]));
}

docs {
  The current user leaves the organization. Owners must transfer ownership first.
}
