meta {
  name: Create Short URL (custom alias and expiry)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/urls
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "url": "https://aiengg.dev",
    "customAlias": "{{alias}}",
    
    "expiresAt": "2030-01-01T00:00:00Z"
  }
}

script:pre-request {
  // Fresh alias each run so re-runs don't hit 409.
  bru.setVar('alias', 'promo-' + Date.now());
}

tests {
  test('201 Created', () => expect(res.getStatus()).to.equal(201));
  test('code is the alias', () => expect(res.getBody().code).to.equal(bru.getVar('alias')));
}

docs {
  customAlias: 3-32 chars of letters, digits, `-` or `_` (409 if taken).
  expiresAt: ISO date in the future; redirect returns 410 after it.
}
