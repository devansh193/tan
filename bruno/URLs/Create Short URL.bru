meta {
  name: Create Short URL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/urls
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "url": "https://aiengg.dev"
  }
}

tests {
  test('201 Created', () => expect(res.getStatus()).to.equal(201));
  try {
    const data = res.getBody();
    test('code present', () => expect(data.code).to.be.a('string').and.not.empty);
    test('shortUrl present', () => expect(data.shortUrl).to.include(data.code));
    test('originalUrl present', () => expect(data.originalUrl).to.be.a('string').and.not.empty);
    if (data.code) bru.setVar('shortCode', data.code);
  } catch (e) {}
  try {
    const r = res.getBody();
    test('shareUrls per channel', () => expect(r.shareUrls.instagram).to.equal(r.shortUrl + '/ig'));
  } catch (e) {}
}

docs {
  Creates a short link owned by the active organization. Requires an active org (403 NO active organization otherwise).
  
  Optional fields: customAlias (3-32 chars) and expiresAt (future ISO date), e.g.
  {
    "url": "https://example.com",
    "customAlias": "promo",
    "expiresAt": "2030-01-01T00:00:00Z"
  }
}
