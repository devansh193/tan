meta {
  name: List Org URLs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/urls?limit=20&offset=0
  body: none
  auth: bearer
}

params:query {
  limit: 20
  offset: 0
}

auth:bearer {
  token: {{sessionToken}}
}

tests {
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  try {
    const data = res.getBody();
    test('items array', () => expect(data.items).to.be.an('array'));
    test('pagination fields', () => {
      expect(data.total).to.be.a('number');
      expect(data.limit).to.be.a('number');
      expect(data.offset).to.be.a('number');
    });
  } catch (e) {}
}

docs {
  Lists the active organization's short links (paginated).
}
