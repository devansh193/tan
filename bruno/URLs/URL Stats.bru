meta {
  name: URL Stats
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/urls/{{shortCode}}/stats
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

tests {
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  try {
    const data = res.getBody();
    test('clickCount present', () => expect(data.clickCount).to.be.a('number'));
    test('recentClicks array', () => expect(data.recentClicks).to.be.an('array'));
  } catch (e) {}
  try {
    const r = res.getBody();
    test('sources array', () => expect(r.sources).to.be.an('array'));
  } catch (e) {}
}

docs {
  Click stats for a link owned by the active organization.
}
